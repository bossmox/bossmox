[Unit]
Description=BossMox: management app for Proxmox Virtual Environment
After=network-online.target
Wants=network-online.target

[Service]
User=bossmox
WorkingDirectory=/opt/bossmox
EnvironmentFile=/etc/bossmox/env
ExecStart=/opt/node/bin/node dist/src/index.js
Restart=always
RestartSec=3
AmbientCapabilities=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
ProtectSystem=strict
# ProtectSystem=strict makes everything read-only, including where settings, preferences and run and move records
# are saved. systemd creates /var/lib/bossmox for the service and leaves it writable (#58).
StateDirectory=bossmox
StateDirectoryMode=0750
ProtectHome=yes
PrivateTmp=yes
# A core dump would hold live Proxmox tickets.
LimitCORE=0

[Install]
WantedBy=multi-user.target
