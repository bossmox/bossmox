# Proxmox address, including the port.
PVE_URL=https://192.0.2.10:8006
# Path to the cluster's CA certificate, copied from /etc/pve/pve-root-ca.pem.
# Leave blank if Proxmox uses a publicly trusted certificate.
PVE_CA_FILE=
# Set this if the certificate lists a different name or address than PVE_URL,
# for example after the server changed IP. The certificate is still verified.
PVE_TLS_NAME=
# Host names people use to open BossMox, comma separated. localhost always works.
BOSSMOX_ALLOWED_HOSTS=
# To use BossMox from other machines it needs HTTPS. Set both of these...
TLS_CERT_FILE=
TLS_KEY_FILE=
# ...or put it behind an HTTPS proxy and set this to 1.
BOSSMOX_BEHIND_HTTPS_PROXY=
# Plain HTTP inside Docker. Only with a published port bound to 127.0.0.1.
BOSSMOX_ALLOW_HTTP=
